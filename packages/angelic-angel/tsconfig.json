{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2024"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "useUnknownInCatchVariables": true,
    "esModuleInterop": true, "skipLibCheck": true, "declaration": true,
    "sourceMap": true, "outDir": "dist", "rootDir": "src", "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
