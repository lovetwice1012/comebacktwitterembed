[Unit]
Description=Retry already encrypted CBTE backup transfers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/cbte-recovery/active_backup.py --config /etc/cbte-recovery/active-backup.json --retry-only
TimeoutStartSec=1900
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
MemoryMax=256M
