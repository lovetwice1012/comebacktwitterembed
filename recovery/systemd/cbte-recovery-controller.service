[Unit]
Description=CBTE automatic standby restoration and emergency promotion
After=network-online.target docker.service cbte-recovery-authority.service
Wants=network-online.target cbte-recovery-authority.service
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/cbte-recovery/controller.py --config /etc/cbte-recovery/controller.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
