[Unit]
Description=CBTE fleet activation lease authority
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/cbte-recovery/authority.py --config /etc/cbte-recovery/authority.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=192M

[Install]
WantedBy=multi-user.target
