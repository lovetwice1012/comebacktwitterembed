[Unit]
Description=CBTE automatic primary failback coordinator
After=network-online.target cbte-recovery-authority.service cbte-recovery-workload.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/cbte-recovery/failback_orchestrator.py --config /etc/cbte-recovery/failback.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true
MemoryMax=192M

[Install]
WantedBy=multi-user.target
