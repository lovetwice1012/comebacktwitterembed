ADMIN_AGENT_LISTEN=127.0.0.1:30988
ADMIN_AGENT_STATE_DIR=/var/lib/cbte-admin
ADMIN_AGENT_PUBLIC_URL=https://cbte.sprink.cloud/ops/
ADMIN_AGENT_BASE_PATH=/ops
ADMIN_AGENT_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ADMIN_OWNER_ID=REPLACE_WITH_OWNER_DISCORD_ID
# Optional bootstrap bcrypt hash. Normal Discord-admin dashboard can set it via
# POST /v1/account/password. Persisted password hash overrides this bootstrap.
ADMIN_AGENT_PASSWORD_HASH=
ADMIN_AGENT_COOKIE_SECURE=true
ADMIN_AGENT_NODE=/usr/local/bin/node
ADMIN_AGENT_WORKER=/opt/cbte-admin/worker-runtime/src/adminSupport/worker.js
ADMIN_AGENT_WORKER_URL=http://127.0.0.1:30990/execute
ADMIN_AGENT_REPORT_WORKER_URL=http://127.0.0.1:30991/execute
ADMIN_AGENT_REPORT_TIMEOUT_SECONDS=660
ADMIN_AGENT_WORKER_DIR=/opt/cbte-admin/worker-runtime
ADMIN_AGENT_WORKER_TIMEOUT_SECONDS=120
ADMIN_AGENT_EXECUTOR_SOCKET=/run/cbte-admin-executor/executor.sock
ADMIN_AGENT_BOT_UNIT=cbte.service
ADMIN_AGENT_LOCAL_HEALTH_URL=http://127.0.0.1:30989/api/health
ADMIN_AGENT_PUBLIC_HEALTH_URL=https://cbte.sprink.cloud/api/health
ADMIN_AGENT_MONITOR_SECONDS=15
ADMIN_AGENT_DISCORD_WEBHOOK=
# Secondary JSON webhook receives {incidentId,revision,title,status,observedAt,url}.
ADMIN_AGENT_PUSH_WEBHOOK=
