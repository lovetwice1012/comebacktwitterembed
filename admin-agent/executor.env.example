ADMIN_AGENT_EXECUTOR_SOCKET=/run/cbte-admin-executor/executor.sock
ADMIN_AGENT_EXECUTOR_STATE_DIR=/var/lib/cbte-admin-executor
# Numeric uid/gid of cbte-admin (root peer is also accepted for dashboard fallback).
ADMIN_AGENT_EXECUTOR_ALLOWED_UID=REPLACE_WITH_CBTE_ADMIN_UID
ADMIN_AGENT_EXECUTOR_GROUP_GID=REPLACE_WITH_CBTE_ADMIN_GID
ADMIN_AGENT_BOT_UNIT=cbte.service
